{
  "name": "@uix-ai/adapter-agentx",
  "version": "0.0.1",
  "description": "Adapter to convert AgentX Presentation state to UIX Lucid IR format",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@uix-ai/core": "workspace:*"
  },
  "peerDependencies": {
    "agentxjs": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "agentxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "uix",
    "agentx",
    "adapter",
    "converter",
    "ai-agent",
    "presentation"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deepractice/UIX.git",
    "directory": "packages/adapter-agentx"
  }
}
