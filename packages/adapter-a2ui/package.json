{
  "name": "@uix/adapter-a2ui",
  "version": "0.0.1",
  "description": "Adapter to convert Google A2UI protocol payloads to UIX Lucid IR format",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@uix/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "uix",
    "a2ui",
    "agent-ui",
    "adapter",
    "protocol",
    "converter",
    "google"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deepractice/UIX.git",
    "directory": "packages/adapter-a2ui"
  }
}
